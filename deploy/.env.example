# Copiar a .env (gitignoreado) y completar. NUNCA versionar el .env real.

# Contraseña de PostgreSQL (interna al compose).
POSTGRES_PASSWORD=cambiame

# Clave de firma de sesiones: 32+ caracteres aleatorios.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECUH_SECRET_KEY=cambiame-por-una-clave-larga-y-aleatoria

# Contraseña del usuario admin inicial del panel.
SECUH_ADMIN_PASSWORD=cambiame

# Topic de ntfy (opcional): https://ntfy.sh/<topic-largo-y-aleatorio>
SECUH_NTFY_TOPIC=

# --- Ajustes operativos (opcionales; descomentar para cambiar) -------------
# Días que se conserva la evidencia antes de borrarse sola. Acordarlo con el
# dueño en la instalación (checklist §Entrega).
#SECUH_RETENTION_DAYS=7

# Resolución de inferencia de YOLO. Bajar a 480 si la CPU va justa
# (runbook §2); menos resolución = menos CPU y algo menos de alcance.
#SECUH_IMGSZ=640

# Segundos de clip grabados antes y después del evento.
#SECUH_CLIP_PRE_SECONDS=10
#SECUH_CLIP_POST_SECONDS=10

# Horas que dura la sesión del panel antes de pedir login otra vez.
#SECUH_SESSION_TTL_HOURS=12

# --- Anotación de escena --------------------------------------------------
# Al detectar una persona se registra y dibuja todo lo demás que se veía
# (mascota, bolso, auto, moto). NO cambia qué dispara un evento ni a quién se
# notifica: eso sigue siendo solo personas. Ver docs/analisis-de-datos.md.
#SECUH_SCENE_ANNOTATION=true

# Confianza mínima para REGISTRAR un objeto en la base de datos. Baja a
# propósito: filtrar al analizar es gratis, recuperar lo descartado no.
#SECUH_SCENE_MIN_CONFIDENCE=0.25

# Confianza mínima para DIBUJAR la caja en la captura. Más alta que la de
# registro: la foto se mira de un vistazo, la base se consulta con filtros.
#SECUH_SCENE_DRAW_MIN_CONFIDENCE=0.45

# Clases a dibujar, como lista JSON. Vacío = todas las detectadas.
# Ejemplo: ["person","dog","cat","car","motorcycle","backpack"]
#SECUH_SCENE_DRAW_LABELS=[]

# Guardar también la captura sin cajas (.raw.jpg), para poder reprocesar el
# histórico con un modelo mejor. Duplica el espacio de capturas (no el de
# clips, que es lo que de verdad pesa).
#SECUH_KEEP_RAW_SNAPSHOT=true
